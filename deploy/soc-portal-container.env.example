# soc-portal — konfigurace prostředí (vzor)
#
# Portál NEMÁ config soubor v kódu; všechno jsou proměnné SOC_PORTAL_* (viz
# soc_portal/config.py). Tenhle soubor je jejich nosič pro provoz.
#
# INSTALACE (mirror soc-api, RHEL sysconfig konvence):
#   sudo cp soc-portal-container.env.example /etc/sysconfig/soc-portal-container
#   sudo chown soc:soc /etc/sysconfig/soc-portal-container
#   sudo chmod 600     /etc/sysconfig/soc-portal-container      # drží TAJEMSTVÍ!
# Systemd unit portálu ho pak načte přes:  EnvironmentFile=-/etc/sysconfig/soc-portal-container
#
# ⚠️ Dva řádky níže jsou TAJEMSTVÍ (klíč aplikace + podpis session). Proto 600
#    a nikdy do gitu — proto je tu jen *.example bez reálných hodnot.

# ── identita portálu vůči access-manageru ────────────────────────────────────
# Jméno služby/komponenty (jediný zdroj pravdy): pole "component" v logách +
# startovní kontrola, že klíč patří TÉTO aplikaci (AM /v1/whoami vrací component).
SOC_PORTAL_SERVICE_NAME=soc-portal
SOC_PORTAL_AUTH_BACKEND=access_manager
SOC_PORTAL_AM_URL=http://127.0.0.1:22000
# Klíč aplikace "soc-portal" (key_id k4). SEM patří nový klíč po rotaci:
SOC_PORTAL_AM_KEY=am_k4_ZDE_VLOZ_NOVY_KLIC
SOC_PORTAL_REALM=soc.autumnpartials.com
SOC_PORTAL_REQUIRED_GROUP=user
# Adresa, ze které portál volá AM (musí být v origin ACL klíče). Host = 127.0.0.1;
# v kontejneru nastav na adresu, pod kterou portál AM vidí.
SOC_PORTAL_AM_CALL_ORIGIN=127.0.0.1

# ── session (podpisové tajemství cookie; ≥16 znaků, náhodné) ──────────────────
# Vygeneruj:  openssl rand -hex 32
SOC_PORTAL_SESSION_SECRET=ZDE_VLOZ_NAHODNE_TAJEMSTVI
SOC_PORTAL_SESSION_ABS_TTL_S=28800
SOC_PORTAL_SESSION_IDLE_S=1800
SOC_PORTAL_SESSION_SECURE=1

# ── data + síť ────────────────────────────────────────────────────────────────
SOC_PORTAL_VAULT=/vault
SOC_PORTAL_BIND_HOST=0.0.0.0
SOC_PORTAL_BIND_PORT=8096
SOC_PORTAL_TRUSTED_PROXY_HOPS=1
